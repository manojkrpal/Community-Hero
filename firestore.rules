rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to extract incoming state
    function incoming() {
      return request.resource.data;
    }

    // Helper to validate individual Issue entity properties
    function isValidIssue(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() > 0 && data.description.size() <= 5000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.severity is string && (data.severity == 'Low' || data.severity == 'Medium' || data.severity == 'High' || data.severity == 'Critical')
        && data.status is string && data.status.size() > 0 && data.status.size() <= 50
        && (data.latitude is float || data.latitude is int)
        && (data.longitude is float || data.longitude is int)
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && data.reporterId is string && data.reporterId.size() > 0 && data.reporterId.size() <= 128
        && data.reporterName is string && data.reporterName.size() > 0 && data.reporterName.size() <= 128;
    }

    // Helper to validate individual User profile properties
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.role is string && data.role.size() > 0 && data.role.size() <= 50
        && (data.reputation is int || data.reputation is float)
        && (data.xp is int || data.xp is float)
        && (data.level is int || data.level is float)
        && data.badges is list
        && data.createdAt is string;
    }

    // Matches the issues collection
    match /issues/{issueId} {
      allow read: if true;
      allow create: if isValidIssue(incoming());
      allow update: if isValidIssue(incoming());
      allow delete: if true;
    }

    // Matches the users collection - allow read for authenticated users to enable lookup & profile display
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && isValidUser(incoming());
    }
  }
}
